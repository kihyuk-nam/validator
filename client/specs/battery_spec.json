    {"id": "R4", "trigger": "true",           "effect": "(<= current 32)"},
    {"id": "R5", "trigger": "(>= temp 60)",   "effect": "(<= current 20)"},
    {"id": "R6", "trigger": "(< temp (- 30))","effect": "fast"}
  ]
